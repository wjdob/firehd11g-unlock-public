; WinUSB function-driver INF for the Amazon/LK fastboot interface.
; Used to bind a driver to USB\VID_1949&PID_05E0 so that `fastboot` (which
; matches the 0xFF/0x42/0x03 interface class) can talk to the device.
; See stage3-recovery/README.md section 0.1.
;
; DeviceInterfaceGUIDs MUST be Android's {F72FE0D4-CBCB-407d-8814-9ED673D0DD6B}.
; Google's fastboot.exe enumerates devices by that GUID alone -- searching the
; binary for each candidate GUID finds F72FE0D4 and none of A5DCBF10 (USB device
; interface) or DEE824EF (WinUSB device interface). With any other GUID the
; driver installs and Device Manager reports the device as working, but
; `fastboot devices` still prints nothing. This matches the [Dev_AddReg]
; section of Google's own android_winusb.inf.

[Version]
Signature           = "$Windows NT$"
Class               = USBDevice
ClassGuid           = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider            = %ManufacturerName%
CatalogFile         = fastboot-amzn.cat
DriverVer           = 10/06/2026,1.0.0.1
PnpLockdown         = 1

[Manufacturer]
%ManufacturerName%  = Standard,NTamd64

[Standard.NTamd64]
%DeviceName%        = USB_Install, USB\VID_1949&PID_05E0

[USB_Install]
Include             = winusb.inf
Needs               = WINUSB.NT

[USB_Install.Services]
Include             = winusb.inf
Needs               = WINUSB.NT.Services

[USB_Install.HW]
AddReg              = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{F72FE0D4-CBCB-407d-8814-9ED673D0DD6B}"

[Strings]
ManufacturerName    = "Local"
DeviceName          = "Android Fastboot (Amazon VID_1949 PID_05E0)"